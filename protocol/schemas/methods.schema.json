{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quipu.local/schemas/methods.schema.json",
  "title": "Quipu JSON-RPC Methods",
  "$defs": {
    "qid": {
      "type": "string",
      "pattern": "^q_[a-z0-9]+_[A-Za-z0-9_-]+$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantId": { "type": ["string", "null"] },
        "userId": { "type": ["string", "null"] },
        "agentId": { "type": ["string", "null"] },
        "projectId": { "type": ["string", "null"] }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "workerState": {
      "type": "string",
      "enum": ["running", "stopped", "unavailable"]
    },
    "evidence": {
      "type": "object",
      "required": ["qid"],
      "additionalProperties": false,
      "properties": {
        "qid": { "$ref": "#/$defs/qid" },
        "quote": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "memoryItem": {
      "type": "object",
      "required": ["qid", "type", "text", "score"],
      "additionalProperties": false,
      "properties": {
        "qid": { "$ref": "#/$defs/qid" },
        "type": {
          "type": "string",
          "enum": ["raw", "message", "episode", "memory_card", "fact", "preference", "procedure", "core", "summary", "entity", "assertion", "pattern"]
        },
        "text": { "type": "string" },
        "score": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "state": {
          "type": "string",
          "enum": ["current", "historical", "superseded", "deleted", "redacted"]
        },
        "validFrom": { "type": ["string", "null"], "format": "date-time" },
        "validTo": { "type": ["string", "null"], "format": "date-time" },
        "slotKey": { "type": "string" },
        "subject": { "type": "string" },
        "attribute": { "type": "string" },
        "value": { "type": "string" },
        "numericValue": { "type": "integer" },
        "unit": { "type": "string" },
        "aggregationMode": {
          "type": "string",
          "enum": ["single_value", "additive"]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "retrievalTrace": {
      "type": "object",
      "required": [
        "query",
        "requestedNeedsCount",
        "budgetTokens",
        "candidateSources",
        "candidateCount",
        "keptCount",
        "droppedForNeeds",
        "droppedForBudget",
        "tokenEstimate"
      ],
      "additionalProperties": false,
      "properties": {
        "query": { "type": "string" },
        "requestedNeedsCount": { "type": "integer", "minimum": 0 },
        "budgetTokens": { "type": "integer", "minimum": 1 },
        "candidateSources": {
          "type": "object",
          "required": ["fts", "vector", "hybrid", "graph", "core"],
          "additionalProperties": false,
          "properties": {
            "fts": { "type": "integer", "minimum": 0 },
            "vector": { "type": "integer", "minimum": 0 },
            "hybrid": { "type": "integer", "minimum": 0 },
            "graph": { "type": "integer", "minimum": 0 },
            "core": { "type": "integer", "minimum": 0 }
          }
        },
        "candidateCount": { "type": "integer", "minimum": 0 },
        "keptCount": { "type": "integer", "minimum": 0 },
        "droppedForNeeds": { "type": "integer", "minimum": 0 },
        "droppedForBudget": { "type": "integer", "minimum": 0 },
        "tokenEstimate": { "type": "integer", "minimum": 0 },
        "validAt": { "type": ["string", "null"], "format": "date-time" },
        "scoreBreakdowns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["qid", "type", "score", "lexical", "temporal", "scope", "confidence", "recency"],
            "additionalProperties": false,
            "properties": {
              "qid": { "$ref": "#/$defs/qid" },
              "type": { "type": "string" },
              "score": { "type": "number" },
              "lexical": { "type": "number" },
              "temporal": { "type": "number" },
              "scope": { "type": "number" },
              "confidence": { "type": "number" },
              "recency": { "type": "number" }
            }
          }
        },
        "scoringDetails": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["qid", "type", "finalScore", "lexical", "temporal", "scope", "confidence", "recency", "formula"],
            "additionalProperties": false,
            "properties": {
              "qid": { "$ref": "#/$defs/qid" },
              "type": { "type": "string" },
              "finalScore": { "type": "number" },
              "lexical": { "type": "number" },
              "temporal": { "type": "number" },
              "scope": { "type": "number" },
              "confidence": { "type": "number" },
              "recency": { "type": "number" },
              "formula": { "type": "string" }
            }
          }
        },
        "droppedItemReasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reason", "count"],
            "additionalProperties": false,
            "properties": {
              "reason": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "rerank": { "$ref": "#/$defs/rerankTrace" },
        "factKeys": { "$ref": "#/$defs/factKeysTrace" },
        "queryExpansion": { "$ref": "#/$defs/queryExpansionTrace" },
        "facts": { "$ref": "#/$defs/factsTrace" },
        "timeAnchors": { "$ref": "#/$defs/timeAnchorsTrace" },
        "patterns": { "$ref": "#/$defs/patternsTrace" },
        "threads": { "$ref": "#/$defs/threadsTrace" }
      }
    },
    "threadsTrace": {
      "type": "object",
      "description": "Present when the scope has summary nodes. The question is compared with every topic summary, claim and session summary of the scope; the nearest topics are shown with their facts, and raw evidence is taken only from the sessions opened: those whose summary is nearest the question, those dated inside a time it names, those the first facts shown were said in, and any session not summarised yet.",
      "required": ["topics", "sessions", "claims", "shown", "facts", "sessionsOpened", "rawDropped", "tokens"],
      "additionalProperties": false,
      "properties": {
        "topics": { "type": "integer", "minimum": 0, "description": "Topic summaries in scope that could be compared with the question." },
        "sessions": { "type": "integer", "minimum": 0, "description": "Session summaries in scope that could be compared with the question." },
        "claims": { "type": "integer", "minimum": 0, "description": "Claims compared with the question." },
        "shown": { "type": "integer", "minimum": 0, "description": "Topics put in the context." },
        "facts": { "type": "integer", "minimum": 0, "description": "Facts put in the context, under a topic or outside one." },
        "sessionsOpened": { "type": "integer", "minimum": 0, "description": "Summarised sessions raw evidence could come from." },
        "rawDropped": { "type": "integer", "minimum": 0, "description": "Raw candidates left out because their session was summarised and not opened." },
        "tokens": { "type": "integer", "minimum": 0, "description": "Budget tokens the threads section took." }
      }
    },
    "patternsTrace": {
      "type": "object",
      "description": "Present when the scope has pattern nodes that could be shown. A pattern node is shown only to a question it owns: more than half of the ten stored sentences nearest the question are sentences the node was built from.",
      "required": ["candidates", "sentences", "ownedMost", "kept", "tokens"],
      "additionalProperties": false,
      "properties": {
        "candidates": { "type": "integer", "minimum": 0, "description": "Current pattern nodes in scope with a finding to show." },
        "sentences": { "type": "integer", "minimum": 0, "description": "Stored sentences compared with the question." },
        "ownedMost": { "type": "integer", "minimum": 0, "maximum": 10, "description": "How many of the ten nearest sentences belong to the node that has the most of them." },
        "kept": { "type": "integer", "minimum": 0, "maximum": 1, "description": "Pattern nodes put in the context." },
        "tokens": { "type": "integer", "minimum": 0, "description": "Budget tokens the pattern node took." }
      }
    },
    "queryExpansionMode": {
      "type": "string",
      "enum": ["off", "rules", "llm"],
      "description": "Query decomposition before candidate generation. off (default) runs the query alone; rules splits recognizable choices and intervals (\"which ... first, X or Y?\", \"between X and Y\") deterministically; llm asks the expansion provider (default: the answer provider) for up to four sub-queries, sending only the query text. The original query always runs, and the per-query candidate lists are fused."
    },
    "queryExpansionTrace": {
      "type": "object",
      "description": "Present in trace and answerTrace only when options.queryExpansion is rules or llm.",
      "required": ["mode", "status", "model", "latencyMs", "queries", "error"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["rules", "llm"] },
        "status": {
          "type": "string",
          "enum": ["expanded", "unchanged", "failed"],
          "description": "unchanged means there was nothing to split; failed means the expansion call or its validation failed, the original query ran alone, and the query_expansion_failed warning was added."
        },
        "model": { "type": ["string", "null"], "description": "The expansion model in llm mode." },
        "latencyMs": { "type": "number", "minimum": 0 },
        "queries": {
          "type": "array",
          "minItems": 1,
          "description": "Every query that ran, the original first.",
          "items": {
            "type": "object",
            "required": ["query", "source", "hitCount", "topQids"],
            "additionalProperties": false,
            "properties": {
              "query": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "enum": ["original", "rules", "llm"] },
              "hitCount": { "type": "integer", "minimum": 0, "description": "Candidates this query returned before fusion." },
              "topQids": {
                "type": "array",
                "items": { "$ref": "#/$defs/qid" },
                "description": "This query's leading candidates, which lead the fused list."
              }
            }
          }
        },
        "error": { "type": ["string", "null"] }
      }
    },
    "timeAnchorsTrace": {
      "type": "object",
      "description": "Present when the question names a time (10 days ago, last Saturday, in January) and time.validAt is given: what people said inside that time is moved ahead of the other candidates, the prompt states the resolved date in a Time references line, and each session dated inside it says so in its header.",
      "required": ["windows", "items", "tokens"],
      "additionalProperties": false,
      "properties": {
        "windows": {
          "type": "integer",
          "minimum": 0,
          "description": "Date windows resolved from the times the question names."
        },
        "items": {
          "type": "integer",
          "minimum": 0,
          "description": "Items dated inside a window that were moved ahead of the other candidates, before the token budget was applied."
        },
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Estimated tokens of those items."
        }
      }
    },
    "factsTrace": {
      "type": "object",
      "description": "Present only when options.facts was true.",
      "required": ["candidates", "kept", "superseded", "linked", "tokens"],
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 0,
          "description": "Claims among the search hits for the query."
        },
        "kept": {
          "type": "integer",
          "minimum": 0,
          "description": "Facts in the context."
        },
        "superseded": {
          "type": "integer",
          "minimum": 0,
          "description": "Of kept, those a later claim replaced as of time.validAt."
        },
        "linked": {
          "type": "integer",
          "minimum": 0,
          "description": "Of kept, those added because a matching fact replaces them or is replaced by them."
        },
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Estimated tokens of the facts section, taken out of the raw evidence budget."
        }
      }
    },
    "factKeysTrace": {
      "type": "object",
      "description": "Present only when options.factKeys was true.",
      "required": ["assertionHits", "evidenceItems", "keptEvidenceItems", "datedItems"],
      "additionalProperties": false,
      "properties": {
        "assertionHits": {
          "type": "integer",
          "minimum": 0,
          "description": "Assertion hits converted to their source chunk or message."
        },
        "evidenceItems": {
          "type": "integer",
          "minimum": 0,
          "description": "Raw candidates that entered through an assertion hit rather than a better-ranked direct hit."
        },
        "keptEvidenceItems": {
          "type": "integer",
          "minimum": 0,
          "description": "Of evidenceItems, those left after the token budget."
        },
        "datedItems": {
          "type": "integer",
          "minimum": 0,
          "description": "Raw candidates carrying at least one claim event date."
        }
      }
    },
    "rerankTrace": {
      "type": "object",
      "description": "Present only when the daemon has a reranker configured.",
      "required": ["model", "status", "windowSize", "rerankedCount", "latencyMs", "topScores"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": ["string", "null"] },
        "status": {
          "type": "string",
          "enum": ["applied", "failed", "disabled", "skipped"],
          "description": "failed keeps the fused order and adds the rerank_failed warning; disabled means options.rerank was false; skipped means there were no candidates."
        },
        "windowSize": { "type": "integer", "minimum": 0 },
        "rerankedCount": { "type": "integer", "minimum": 0 },
        "latencyMs": { "type": "number", "minimum": 0 },
        "topScores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["qid", "score"],
            "additionalProperties": false,
            "properties": {
              "qid": { "$ref": "#/$defs/qid" },
              "score": { "type": "number" }
            }
          }
        },
        "error": { "type": ["string", "null"] }
      }
    },
    "answerTrace": {
      "type": "object",
      "required": [
        "strategy",
        "answerable",
        "supportQids",
        "supportValid",
        "candidateAnswers",
        "normalizedAnswer",
        "validation"
      ],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "description": "Describes which answer path ran; it never routes the question.",
          "enum": ["llm_reader", "deterministic_fallback", "abstain"]
        },
        "readerMode": {
          "type": "string",
          "description": "Reader prompt that produced the answer: none when no reader was called, reasoning when options.readerReasoning was applied.",
          "enum": ["none", "direct", "reasoning"]
        },
        "temporalHints": {
          "type": "boolean",
          "description": "True when options.temporalHints was applied: it was requested and time.validAt was a parseable date."
        },
        "timeReferences": {
          "type": ["string", "null"],
          "description": "Relative time expressions from the query resolved to dates, as sent on the reader's Time references line; null when none matched or hints were off."
        },
        "queryExpansion": { "$ref": "#/$defs/queryExpansionTrace" },
        "answerable": { "type": "boolean" },
        "supportQids": {
          "type": "array",
          "items": { "$ref": "#/$defs/qid" }
        },
        "supportValid": {
          "type": "boolean",
          "description": "False when the reader cited qids missing from the context, or cited none for an answerable answer."
        },
        "candidateAnswers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "supportQids", "confidence", "source"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string" },
              "supportQids": {
                "type": "array",
                "items": { "$ref": "#/$defs/qid" }
              },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "source": { "type": "string", "enum": ["heuristic", "provider"] }
            }
          }
        },
        "reasoning": {
          "type": ["string", "null"],
          "description": "The reader's evidence review in reasoning mode; never part of answer. Null in direct mode or when the reader gave none (a missing_reasoning or invalid_reasoning warning is added)."
        },
        "rawProviderAnswer": { "type": ["string", "null"] },
        "normalizedAnswer": { "type": "string" },
        "validation": {
          "type": "object",
          "required": ["status", "warnings"],
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string", "enum": ["accepted", "abstained", "parse_error", "invalid_support"] },
            "warnings": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "systemHealthParams": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "systemHealthResult": {
      "type": "object",
      "required": ["status", "version", "protocolVersion", "schemaVersion", "storage", "workers"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["ok", "degraded", "error"] },
        "version": { "type": "string" },
        "protocolVersion": { "type": "string" },
        "dbPath": { "type": ["string", "null"] },
        "latticeVersion": { "type": ["string", "null"] },
        "schemaVersion": { "type": "integer", "minimum": 0 },
        "storage": { "$ref": "#/$defs/storageCapabilities" },
        "workers": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/workerState" }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "reranker": {
              "type": "object",
              "required": ["configured", "model"],
              "additionalProperties": false,
              "properties": {
                "configured": { "type": "boolean" },
                "model": { "type": ["string", "null"] }
              }
            },
            "extractor": {
              "type": "object",
              "required": ["configured", "model", "promptVersion"],
              "additionalProperties": false,
              "description": "LLM fact extraction for extract jobs (quipu jobs run extract).",
              "properties": {
                "configured": { "type": "boolean" },
                "model": { "type": ["string", "null"] },
                "promptVersion": { "type": "string" }
              }
            },
            "factKeys": {
              "type": "boolean",
              "description": "memory.retrieve and memory.answer accept options.factKeys."
            },
            "facts": {
              "type": "boolean",
              "description": "memory.retrieve and memory.answer accept options.facts."
            },
            "timeAnchors": {
              "type": "boolean",
              "description": "memory.retrieve and memory.answer resolve a time the question names and anchor the context on what was said then. Not an option."
            },
            "summaries": {
              "type": "object",
              "required": ["available", "promptVersion", "model"],
              "additionalProperties": false,
              "description": "Summary nodes: a title and summary of each conversation, and of each group of facts about one subject, written by the background worker. Built when the store embeds text and an extract provider is configured; memory.retrieve and memory.answer read them first, show the topics nearest the question and take raw evidence from the sessions they point at. Not an option.",
              "properties": {
                "available": { "type": "boolean", "description": "True when the store can embed text." },
                "promptVersion": { "type": "string" },
                "model": { "type": ["string", "null"], "description": "The chat model summary jobs call: the extract model. Null when none is configured." }
              }
            },
            "patterns": {
              "type": "object",
              "required": ["available", "promptVersion", "model"],
              "additionalProperties": false,
              "description": "Pattern nodes: what the background worker works out from occasions that recur. Built when the store embeds text and an extract provider is configured; memory.retrieve and memory.answer show one to a question it owns.",
              "properties": {
                "available": { "type": "boolean", "description": "True when the store can embed sentences." },
                "promptVersion": { "type": "string" },
                "model": { "type": ["string", "null"], "description": "The chat model pattern jobs call: the pattern model when one is configured, otherwise the extract model. Null when neither is." }
              }
            },
            "queryExpansion": {
              "type": "object",
              "required": ["modes", "llmConfigured", "model"],
              "additionalProperties": false,
              "properties": {
                "modes": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/queryExpansionMode" }
                },
                "llmConfigured": {
                  "type": "boolean",
                  "description": "True when an expansion or answer chat provider can serve options.queryExpansion llm."
                },
                "model": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    "storageCapabilities": {
      "type": "object",
      "required": ["backend", "durable", "fullText", "vector", "streams", "transactions", "verification"],
      "additionalProperties": false,
      "properties": {
        "backend": { "type": "string" },
        "durable": { "type": "boolean" },
        "fullText": { "type": "boolean" },
        "vector": { "type": "boolean" },
        "streams": { "type": "boolean" },
        "transactions": { "type": "boolean" },
        "verification": { "type": "boolean" },
        "vectorDimensions": { "type": ["integer", "null"], "minimum": 1 },
        "embeddingModel": { "type": ["string", "null"] }
      }
    },
    "memoryRememberParams": {
      "type": "object",
      "required": ["messages"],
      "additionalProperties": false,
      "properties": {
        "sessionId": { "type": "string" },
        "scope": { "$ref": "#/$defs/scope" },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "enum": ["system", "developer", "user", "assistant", "tool"]
              },
              "content": { "type": "string", "minLength": 1 },
              "createdAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "toolCalls": { "type": "array" },
        "observations": { "type": "array" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "extract": { "type": "boolean" },
        "importanceHint": { "type": "number", "minimum": 0, "maximum": 1 },
        "privacyClass": {
          "type": "string",
          "enum": ["public", "normal", "private", "secret"]
        },
        "idempotencyKey": { "type": "string" }
      }
    },
    "memoryRememberResult": {
      "type": "object",
      "required": ["sessionQid", "turnQid", "messageQids", "queuedJobs", "status"],
      "additionalProperties": false,
      "properties": {
        "sessionQid": { "$ref": "#/$defs/qid" },
        "turnQid": { "$ref": "#/$defs/qid" },
        "messageQids": {
          "type": "array",
          "items": { "$ref": "#/$defs/qid" }
        },
        "queuedJobs": {
          "type": "array",
          "items": { "$ref": "#/$defs/qid" }
        },
        "status": { "type": "string", "enum": ["stored", "duplicate"] }
      }
    },
    "memoryRetrieveParams": {
      "type": "object",
      "required": ["query"],
      "additionalProperties": false,
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "task": { "type": "string" },
        "mode": { "type": "string", "enum": ["fts", "vector", "hybrid", "graph"] },
        "scope": { "$ref": "#/$defs/scope" },
        "budgetTokens": { "type": "integer", "minimum": 1 },
        "needs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["core", "current_facts", "preferences", "procedural", "recent_episodes", "raw"]
          }
        },
        "time": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "validAt": { "type": ["string", "null"], "format": "date-time" },
            "eventWindowStart": { "type": ["string", "null"], "format": "date-time" },
            "eventWindowEnd": { "type": ["string", "null"], "format": "date-time" }
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "includeEvidence": { "type": "boolean" },
            "includeDebug": { "type": "boolean" },
            "logTrace": { "type": "boolean" },
            "logRetrieval": { "type": "boolean" },
            "abstainIfWeak": { "type": "boolean" },
            "rerank": {
              "type": "boolean",
              "description": "Set false to bypass a configured reranker for this request. Default true."
            },
            "rerankCandidates": {
              "type": "integer",
              "minimum": 1,
              "description": "Leading candidates sent to a configured reranker. Default 50."
            },
            "temporalHints": {
              "type": "boolean",
              "description": "Append each session header's offset from time.validAt. The Time references line that resolves the query's relative dates does not depend on this option: it is written whenever time.validAt is a parseable date. Default false."
            },
            "factKeys": {
              "type": "boolean",
              "description": "Let extracted claims (Assertion nodes) act as extra search keys: an assertion hit is returned as its source chunk or message, never as itself, and raw lines show the claims' event dates as [event YYYY-MM-DD]. Default false: assertions take no part in retrieval."
            },
            "facts": {
              "type": "boolean",
              "description": "Put the matching claims that consolidation found replaced, each with the claim that replaced it, ahead of the raw evidence, as a facts section of dated lines: (superseded, YYYY-MM-DD to YYYY-MM-DD) and (current, from YYYY-MM-DD). A claim with no replacement is not listed. The section uses at most 30% of the token budget, taken from the raw evidence; each fact is listed under the qid of the message it was drawn from. Default false: claims and updates take no part in the context."
            },
            "queryExpansion": { "$ref": "#/$defs/queryExpansionMode" },
            "format": { "type": "string", "enum": ["prompt", "json"] }
          }
        }
      }
    },
    "memoryRetrieveResult": {
      "type": "object",
      "required": ["retrievalId", "context", "items", "tokenEstimate", "confidence", "warnings"],
      "additionalProperties": false,
      "properties": {
        "retrievalId": { "$ref": "#/$defs/qid" },
        "prompt": { "type": "string" },
        "context": {
          "type": "object",
          "required": ["core", "currentFacts", "preferences", "procedural", "patterns", "threads", "episodes", "warnings"],
          "additionalProperties": false,
          "properties": {
            "core": {
              "type": "array",
              "items": { "$ref": "#/$defs/memoryItem" }
            },
            "currentFacts": {
              "type": "array",
              "items": { "$ref": "#/$defs/memoryItem" }
            },
            "preferences": {
              "type": "array",
              "items": { "$ref": "#/$defs/memoryItem" }
            },
            "procedural": {
              "type": "array",
              "items": { "$ref": "#/$defs/memoryItem" }
            },
            "patterns": {
              "type": "array",
              "maxItems": 1,
              "description": "A pattern node the question owns: a regularity the memory worked out across occasions, or the record that it compared them and found none. Its evidence is the messages of those occasions.",
              "items": { "$ref": "#/$defs/memoryItem" }
            },
            "threads": {
              "type": "array",
              "description": "What the summary layer has for the question, in the order it is shown: each topic near the question as an item of type summary (its text is the topic's title and summary, its evidence the message of each fact shown under it, quoting the fact), and each fact shown outside a topic as an item of type assertion. Empty when the scope has no summaries.",
              "items": { "$ref": "#/$defs/memoryItem" }
            },
            "episodes": {
              "type": "array",
              "items": { "$ref": "#/$defs/memoryItem" }
            },
            "warnings": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/memoryItem" }
        },
        "tokenEstimate": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "trace": {
          "anyOf": [
            { "$ref": "#/$defs/retrievalTrace" },
            { "type": "null" }
          ]
        }
      }
    },
    "memoryAnswerParams": {
      "type": "object",
      "required": ["query"],
      "additionalProperties": false,
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "task": { "type": "string" },
        "mode": { "type": "string", "enum": ["fts", "vector", "hybrid", "graph"] },
        "scope": { "$ref": "#/$defs/scope" },
        "budgetTokens": { "type": "integer", "minimum": 1 },
        "needs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["core", "current_facts", "preferences", "procedural", "recent_episodes", "raw"]
          }
        },
        "time": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "validAt": { "type": ["string", "null"], "format": "date-time" },
            "eventWindowStart": { "type": ["string", "null"], "format": "date-time" },
            "eventWindowEnd": { "type": ["string", "null"], "format": "date-time" }
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "includeEvidence": { "type": "boolean" },
            "includeDebug": { "type": "boolean" },
            "logTrace": { "type": "boolean" },
            "logRetrieval": { "type": "boolean" },
            "abstainIfWeak": { "type": "boolean" },
            "rerank": {
              "type": "boolean",
              "description": "Set false to bypass a configured reranker for this request. Default true."
            },
            "rerankCandidates": {
              "type": "integer",
              "minimum": 1,
              "description": "Leading candidates sent to a configured reranker. Default 50."
            },
            "readerReasoning": {
              "type": "boolean",
              "description": "Ask the reader to review the evidence in a reasoning field before answering; reported in answerTrace.reasoning. Default false."
            },
            "temporalHints": {
              "type": "boolean",
              "description": "Append each session header's offset from time.validAt and give the reader a Time references line resolving the query's relative dates. Default false."
            },
            "factKeys": {
              "type": "boolean",
              "description": "Let extracted claims (Assertion nodes) act as extra search keys: an assertion hit is returned as its source chunk or message, never as itself, and raw lines show the claims' event dates as [event YYYY-MM-DD]. Default false: assertions take no part in retrieval."
            },
            "facts": {
              "type": "boolean",
              "description": "Put the matching claims that consolidation found replaced, each with the claim that replaced it, ahead of the raw evidence, as a facts section of dated lines: (superseded, YYYY-MM-DD to YYYY-MM-DD) and (current, from YYYY-MM-DD). A claim with no replacement is not listed. The section uses at most 30% of the token budget, taken from the raw evidence; each fact is listed under the qid of the message it was drawn from. Default false: claims and updates take no part in the context."
            },
            "queryExpansion": { "$ref": "#/$defs/queryExpansionMode" },
            "format": { "type": "string", "enum": ["prompt", "json"] }
          }
        }
      }
    },
    "memoryAnswerResult": {
      "type": "object",
      "required": ["retrievalId", "answer", "provider", "context", "items", "tokenEstimate", "confidence", "warnings"],
      "additionalProperties": false,
      "properties": {
        "retrievalId": { "$ref": "#/$defs/qid" },
        "answer": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": ["string", "null"] },
        "prompt": {
          "type": ["string", "null"],
          "description": "Exact memory context string sent to the reader; present when options.includeDebug is true."
        },
        "context": {
          "type": "object",
          "required": ["core", "currentFacts", "preferences", "procedural", "patterns", "threads", "episodes", "warnings"],
          "additionalProperties": false,
          "properties": {
            "core": {
              "type": "array",
              "items": { "$ref": "#/$defs/memoryItem" }
            },
            "currentFacts": {
              "type": "array",
              "items": { "$ref": "#/$defs/memoryItem" }
            },
            "preferences": {
              "type": "array",
              "items": { "$ref": "#/$defs/memoryItem" }
            },
            "procedural": {
              "type": "array",
              "items": { "$ref": "#/$defs/memoryItem" }
            },
            "patterns": {
              "type": "array",
              "maxItems": 1,
              "description": "A pattern node the question owns: a regularity the memory worked out across occasions, or the record that it compared them and found none. Its evidence is the messages of those occasions.",
              "items": { "$ref": "#/$defs/memoryItem" }
            },
            "threads": {
              "type": "array",
              "description": "What the summary layer has for the question, in the order it is shown: each topic near the question as an item of type summary (its text is the topic's title and summary, its evidence the message of each fact shown under it, quoting the fact), and each fact shown outside a topic as an item of type assertion. Empty when the scope has no summaries.",
              "items": { "$ref": "#/$defs/memoryItem" }
            },
            "episodes": {
              "type": "array",
              "items": { "$ref": "#/$defs/memoryItem" }
            },
            "warnings": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/memoryItem" }
        },
        "tokenEstimate": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "trace": {
          "anyOf": [
            { "$ref": "#/$defs/retrievalTrace" },
            { "type": "null" }
          ]
        },
        "answerTrace": {
          "anyOf": [
            { "$ref": "#/$defs/answerTrace" },
            { "type": "null" }
          ]
        }
      }
    },
    "memorySearchParams": {
      "type": "object",
      "required": ["query"],
      "additionalProperties": false,
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["fts", "vector", "hybrid", "graph"] },
        "labels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scope": { "$ref": "#/$defs/scope" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "includeDeleted": { "type": "boolean" }
      }
    },
    "memorySearchResult": {
      "type": "object",
      "required": ["results"],
      "additionalProperties": false,
      "properties": {
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/memoryItem" }
        }
      }
    },
    "memoryInspectParams": {
      "type": "object",
      "required": ["qid"],
      "additionalProperties": false,
      "properties": {
        "qid": { "$ref": "#/$defs/qid" },
        "includeProvenance": { "type": "boolean" },
        "includeDependents": { "type": "boolean" },
        "includeRaw": { "type": "boolean" }
      }
    },
    "memoryInspectResult": {
      "type": "object",
      "required": ["node", "provenance", "dependents", "audit"],
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "object",
          "required": ["qid", "type", "properties"],
          "additionalProperties": false,
          "properties": {
            "qid": { "$ref": "#/$defs/qid" },
            "type": { "type": "string" },
            "properties": { "$ref": "#/$defs/metadata" }
          }
        },
        "provenance": { "type": "array" },
        "dependents": { "type": "array" },
        "audit": { "type": "array" }
      }
    },
    "memoryForgetParams": {
      "type": "object",
      "required": ["mode", "selector"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["hard_delete", "redact", "expire"] },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            { "required": ["qids"] },
            {
              "required": ["query"],
              "properties": {
                "query": { "type": "string", "minLength": 1 }
              }
            }
          ],
          "properties": {
            "qids": {
              "type": "array",
              "items": { "$ref": "#/$defs/qid" }
            },
            "query": { "type": ["string", "null"] },
            "scope": { "$ref": "#/$defs/scope" },
            "timeWindow": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "start": { "type": ["string", "null"], "format": "date-time" },
                "end": { "type": ["string", "null"], "format": "date-time" }
              }
            }
          }
        },
        "propagate": { "type": "boolean" },
        "dryRun": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "memoryForgetResult": {
      "type": "object",
      "required": [
        "deletionRequestQid",
        "status",
        "dryRun",
        "rootsMatched",
        "nodesDeleted",
        "nodesRedacted",
        "factsInvalidated",
        "summariesContaminated",
        "jobsQueued",
        "report"
      ],
      "additionalProperties": false,
      "properties": {
        "deletionRequestQid": { "$ref": "#/$defs/qid" },
        "status": { "type": "string", "enum": ["planned", "completed"] },
        "dryRun": { "type": "boolean" },
        "rootsMatched": { "type": "integer", "minimum": 0 },
        "nodesDeleted": { "type": "integer", "minimum": 0 },
        "nodesRedacted": { "type": "integer", "minimum": 0 },
        "factsInvalidated": { "type": "integer", "minimum": 0 },
        "summariesContaminated": { "type": "integer", "minimum": 0 },
        "jobsQueued": {
          "type": "array",
          "items": { "$ref": "#/$defs/qid" }
        },
        "report": { "type": "array" }
      }
    },
    "memoryFeedbackParams": {
      "type": "object",
      "required": ["retrievalId", "rating"],
      "additionalProperties": false,
      "properties": {
        "retrievalId": { "$ref": "#/$defs/qid" },
        "rating": { "type": "string", "enum": ["helpful", "not_helpful", "harmful"] },
        "usedItemQids": {
          "type": "array",
          "items": { "$ref": "#/$defs/qid" }
        },
        "ignoredItemQids": {
          "type": "array",
          "items": { "$ref": "#/$defs/qid" }
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "text"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string" },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "memoryFeedbackResult": {
      "type": "object",
      "required": ["feedbackQid", "queuedJobs", "status"],
      "additionalProperties": false,
      "properties": {
        "feedbackQid": { "$ref": "#/$defs/qid" },
        "queuedJobs": {
          "type": "array",
          "items": { "$ref": "#/$defs/qid" }
        },
        "status": { "type": "string", "enum": ["stored"] }
      }
    },
    "memoryCoreGetParams": {
      "type": "object",
      "required": ["scope"],
      "additionalProperties": false,
      "properties": {
        "scope": { "$ref": "#/$defs/scope" },
        "blockKey": { "type": "string" }
      }
    },
    "memoryCoreGetResult": {
      "type": "object",
      "required": ["blocks"],
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["qid", "blockKey", "scope", "text", "managedBy"],
            "additionalProperties": false,
            "properties": {
              "qid": { "$ref": "#/$defs/qid" },
              "blockKey": { "type": "string" },
              "scope": { "$ref": "#/$defs/scope" },
              "text": { "type": "string" },
              "managedBy": { "type": "string", "enum": ["user", "system"] },
              "evidenceQids": {
                "type": "array",
                "items": { "$ref": "#/$defs/qid" }
              }
            }
          }
        }
      }
    },
    "memoryCoreUpdateParams": {
      "type": "object",
      "required": ["blockKey", "scope", "text", "mode", "managedBy"],
      "additionalProperties": false,
      "properties": {
        "blockKey": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "text": { "type": "string" },
        "mode": { "type": "string", "enum": ["replace", "append"] },
        "evidenceQids": {
          "type": "array",
          "items": { "$ref": "#/$defs/qid" }
        },
        "managedBy": { "type": "string", "enum": ["user", "system"] }
      }
    },
    "memoryCoreUpdateResult": {
      "type": "object",
      "required": ["blockQid", "status"],
      "additionalProperties": false,
      "properties": {
        "blockQid": { "$ref": "#/$defs/qid" },
        "status": { "type": "string", "enum": ["stored", "updated"] }
      }
    }
  }
}
